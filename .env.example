# Copy this file to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ServiceChannel contractor API — two-way pull/push when all four are set.
SERVICECHANNEL_USERNAME=
SERVICECHANNEL_PASSWORD=
SERVICECHANNEL_CLIENT_ID=
SERVICECHANNEL_CLIENT_SECRET=
# SERVICECHANNEL_SANDBOX=1

# Outlook / Microsoft Graph — unread mailbox intake when all four are set.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=

# Shared secret for ServiceChannel + Outlook webhooks (x-mtc-intake).
INTAKE_WEBHOOK_SECRET=
CRON_SECRET=

# Comma-separated emails that always get the owner/admin dashboard.
ADMIN_EMAILS=
